name: localmodelproxy
default_branch: main
config:
  description: "Local OpenAI-compatible proxy for routing model requests across configurable backends while handling credentials and tracking token usage."
  license: MIT
  language: go
  release: release-go
  justfile: true
  status: active
  release_github: true
  codecov:
    enabled: false
  docs:
    enabled: true
    domain: localmodelproxy.unitvectorylabs.com